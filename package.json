{
  "name": "@hayanjongseong/kras-quick",
  "version": "2.0.2",
  "description": "KRAS Quick Windows launcher",
  "type": "module",
  "bin": { "kras-quick": "bin/kras-quick.js" },
  "engines": { "node": ">=18" },
  "files": ["bin/kras-quick.js", "README.md", "LICENSE"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/HaYanJongSeong/kras-quick.git" },
  "scripts": {
    "test": "node --test tests/launcher.test.js",
    "typecheck": "npm --prefix source run typecheck",
    "test:kras": "npm --prefix source run test:kras",
    "test:property": "npm --prefix source run test:property",
    "test:all": "npm test && npm --prefix source run test:all"
  }
}
